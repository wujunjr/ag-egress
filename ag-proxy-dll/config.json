{
  "_version": "2.2",
  "_comment": "Antigravity-Proxy config - pointed at mihomo 7897 -> ag-egress tunnel (US egress)",
  "proxy": {
    "port": 7897,
    "type": "socks5",
    "host": "127.0.0.1"
  },
  "_changed_2026-08-30": [
    "proxy.port 7890 -> 7897 (mihomo mixed port, not SpeedCat 7892)",
    "dns_mode direct -> proxy  (direct made DNS resolve to CN nodes => still 400)",
    "ipv6_mode proxy -> block  (mihomo runs with ipv6:false; force IPv4 to avoid atype-3 issues)"
  ],
  "child_injection": true,
  "child_injection_exclude": [],
  "log_level": "info",
  "proxy_rules": {
    "routing": {
      "default_action": "proxy",
      "use_default_private": true,
      "enabled": true,
      "priority_mode": "order",
      "rules": []
    },
    "ipv6_mode": "block",
    "udp_mode": "block",
    "dns_mode": "proxy",
    "allowed_ports": [
      80,
      443
    ],
    "udp_fallback": "block"
  },
  "fake_ip": {
    "enabled": true,
    "cidr": "198.18.0.0/15"
  },
  "timeout": {
    "send": 10000,
    "recv": 10000,
    "connect": 10000
  },
  "target_processes": [
    "agy.exe",
    "language_server.exe",
    "language_server_windows",
    "Antigravity.exe",
    "Antigravity IDE.exe",
    "node.exe"
  ],
  "_build": {
    "arch": "x64",
    "date": "2026-06-19 17:40:47",
    "config": "Release"
  },
  "updates": {
    "enabled": false,
    "check_delay_ms": 15000,
    "mirrors": [],
    "allow_insecure_mirrors": false,
    "notify_once": true,
    "timeout_ms": 5000
  },
  "traffic_logging": false,
  "child_injection_mode": "filtered"
}
